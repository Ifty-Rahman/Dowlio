{
  "manifest_version": 3,
  "name": "Dowlio Connect",
  "description": "Finishes your browser downloads in Dowlio, the download manager for Mac.",
  "version": "0.2.0",
  "minimum_chrome_version": "116",
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Dowlio Connect",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["alarms", "downloads", "storage", "contextMenus", "notifications"]
}
